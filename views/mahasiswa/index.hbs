<div>
    <h1>List mahasiswa</h1>
    {{#if error}}
        <p id="dosen-error" role="alert" data-message="{{error}}">{{error}}</p>
        <script>
            window.alert(document.getElementById('dosen-error').dataset.message);
            window.location.assign('/dosen');
        </script>
    {{/if}}
    {{#each mahasiswa}}
        <p>{{nama}} - {{nim}} = {{dosen.nama}}</p>
        <form method="post" action="/dosen/delete/{{id}}">
            <button type="submit">Hapus</button>
        </form>
    {{/each}}
</div>