<div>
  <h1>List dosen terdaftar</h1>

  {{!-- form cari --}}
  <form method="GET" action="/dosen">
    <input type="text" name="search" placeholder="Cari nama dosen..." value="{{search}}" />
    <button type="submit">Cari</button>
    <a href="/dosen">Reset</a>
  </form>

  {{! form tambah dosen }}
  <form method='post' action='/dosen'>
    <input type='text' name='nama' placeholder='Nama dosen' required />
    <input type='text' name='mata_kuliah' placeholder='Mata kuliah' required />
    <button type='submit'>Tambah</button>
  </form>

  {{! error alert }}
  {{#if error}}
    <p id='error' role='alert' data-message='{{error}}'>{{error}}</p>
    <script>
      window.alert(document.getElementById('error').dataset.message);
      window.location.assign('/dosen');
    </script>
  {{/if}}

  {{! tampilan data dosen }}
  <div class='container'>
    {{#each dosen}}
      <div class='item-list'>
        <h2>{{nama}}</h2>
        <p>Mata kuliah: {{mata_kuliah}}</p>

        <div class='btn-container'>
          <form method='post' action='/dosen/{{id}}/delete'>
            <button class='btn' type='submit'>Hapus</button>
          </form>
          <a class='btn' href='/dosen/{{id}}/edit'>Edit</a>
        </div>
      </div>

      {{ else }}
        <p>Belum ada dosen terdaftar</p>
    {{/each}}
  </div>

</div>